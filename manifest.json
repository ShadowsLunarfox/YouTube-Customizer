{
  "manifest_version": 3,
  "name": "YouTube Customizer",
  "description": "Personalize YouTube backgrounds, colors, progress icons, and page layout.",
  "version": "2.5.17",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting", "unlimitedStorage"],
  "host_permissions": ["https://*.youtube.com/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"
  },
  "action": {
    "default_title": "YouTube Customizer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": [
        "settings.js",
        "content/surface-controller.js",
        "content/shorts-controller.js",
        "content/homepage-glass.js",
        "content/home-shorts-grid.js",
        "content/audio-controller.js",
        "yt.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
