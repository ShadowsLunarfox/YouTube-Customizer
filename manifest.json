{
  "manifest_version": 3,
  "name": "YouTube Customizer",
  "description": "Personalize YouTube backgrounds, colors, progress icons, and page layout.",
  "version": "2.13.7",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting", "unlimitedStorage"],
  "background": { "service_worker": "service-worker.js" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+Y" } },
    "toggle-picture-in-picture": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Toggle video picture-in-picture / 切换影片画中画"
    },
    "toggle-audio-enhancement": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Toggle audio enhancement / 切换声音增强"
    }
  },
  "host_permissions": ["https://*.youtube.com/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self' https://youtube.com https://*.youtube.com;"
  },
  "action": {
    "default_title": "YouTube Customizer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "web_accessible_resources": [{ "resources": ["popup.html", "icons/icon-32.png"], "matches": ["https://*.youtube.com/*"] }],
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": [
        "settings.js",
        "i18n.js",
        "menu-theme.js",
        "content/surface-controller.js",
        "content/shorts-controller.js",
        "content/homepage-glass.js",
        "content/home-shorts-grid.js",
        "content/audio-controller.js",
        "content/music-theme.js",
        "content/picture-in-picture.js",
        "content/in-page-settings.js",
        "content/video-bookmarks.js",
        "content/default-shortcuts.js",
        "yt.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
